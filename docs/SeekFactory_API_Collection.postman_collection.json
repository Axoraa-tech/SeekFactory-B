    {
      "name": "01. Authentication",
      "item": [
        {
          "name": "Register Buyer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const res = pm.response.json();",
                  "    if (res.data && res.data.access_token) {",
                  "        pm.environment.set('authToken', res.data.access_token);",
                  "        pm.environment.set('refreshToken', res.data.refresh_token);",
                  "        if (res.data.user) pm.environment.set('userId', res.data.user.id);",
                  "        console.log('✅ Buyer token & userId saved!');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Arjun Sharma\",\n  \"email\": \"arjun.buyer@example.com\",\n  \"password\": \"Password@123\",\n  \"role\": \"BUYER\",\n  \"companyName\": \"Apex Precision Components India\",\n  \"industry\": \"Automotive Tier-2\",\n  \"country\": \"India\",\n  \"phone\": \"+919876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
