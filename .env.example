# ============================================================
# SPRING BOOT PROFILE
# ============================================================
SPRING_PROFILES_ACTIVE=dev


# ============================================================
# DEVELOPMENT DATABASE - SUPABASE
# ============================================================
DEV_DB_URL=jdbc:postgresql://YOUR-DEV-SUPABASE-HOST:5432/postgres
DEV_DB_USERNAME=YOUR_DEV_SUPABASE_USERNAME
DEV_DB_PASSWORD=YOUR_DEV_SUPABASE_PASSWORD


# ============================================================
# PRODUCTION DATABASE - SUPABASE
# ============================================================
PROD_DB_URL=jdbc:postgresql://YOUR-PROD-SUPABASE-HOST:5432/postgres
PROD_DB_USERNAME=YOUR_PROD_SUPABASE_USERNAME
PROD_DB_PASSWORD=YOUR_PROD_SUPABASE_PASSWORD


# ============================================================
# JWT
# ============================================================
JWT_SECRET=YOUR_VERY_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS


# ============================================================
# GOOGLE OAUTH
# ============================================================
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID

# ============================================================
# PLATFORM / CLOUD OVERRIDES (optional)
# These take precedence over DEV_DB_* / PROD_DB_* above.
# Use them on Railway, Heroku, Render or any platform that
# injects a DATABASE_URL automatically.
# ============================================================
# DB_URL=jdbc:postgresql://HOST:5432/dbname   (highest precedence)
# DATABASE_URL=jdbc:postgresql://HOST:5432/dbname
# DB_USERNAME=username
# DB_PASSWORD=password
# DB_POOL_SIZE=20           (HikariCP pool; default 20)
# PORT=8080                 (HTTP port; default 8080)

# ============================================================
# MEDIA COMPRESSION (optional; defaults shown)
# ============================================================
# Photos: longest side capped, re-encoded as JPEG (transparent PNGs stay PNG)
# APP_MEDIA_IMAGE_MAX_DIMENSION=2048
# APP_MEDIA_IMAGE_QUALITY=0.85
# Videos: compressed in the background with ffmpeg (H.264 CRF 23, max 1080p/30fps).
# Leave unset if ffmpeg is on the PATH; without ffmpeg, videos are stored as uploaded.
# APP_MEDIA_FFMPEG_PATH=ffmpeg
# APP_MEDIA_VIDEO_CRF=23
# APP_MEDIA_VIDEO_PRESET=medium
