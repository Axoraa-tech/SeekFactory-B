# ============================================================
# SPRING BOOT PROFILE
# ============================================================
SPRING_PROFILES_ACTIVE=dev


# ============================================================
# DEVELOPMENT DATABASE - SUPABASE
# ============================================================
DEV_DB_URL=jdbc:postgresql://YOUR-DEV-SUPABASE-HOST:5432/postgres
DEV_DB_USERNAME=YOUR_DEV_SUPABASE_USERNAME
DEV_DB_PASSWORD=YOUR_DEV_SUPABASE_PASSWORD


# ============================================================
# PRODUCTION DATABASE - SUPABASE
# ============================================================
PROD_DB_URL=jdbc:postgresql://YOUR-PROD-SUPABASE-HOST:5432/postgres
PROD_DB_USERNAME=YOUR_PROD_SUPABASE_USERNAME
PROD_DB_PASSWORD=YOUR_PROD_SUPABASE_PASSWORD


# ============================================================
# JWT
# ============================================================
JWT_SECRET=YOUR_VERY_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
# Production refuses to start without a JWT_SECRET of at least 32 bytes. Generate one per environment:
#   openssl rand -base64 48


# ============================================================
# EMAIL (verification links, password reset)
# ============================================================
# Without SPRING_MAIL_HOST no email is sent; the dev profile only prints it to the console.
# Links in the emails point at APP_FRONTEND_URL (the web app), so set it per environment.
APP_FRONTEND_URL=http://localhost:3000
# APP_MAIL_FROM must be an address the SMTP account is allowed to send from.
# APP_MAIL_FROM=SeekFactory <no-reply@seekfactory.com>
#
# Quick test with a Gmail account (needs 2-step verification + an App Password,
# https://myaccount.google.com/apppasswords; APP_MAIL_FROM must be that Gmail address):
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=your.account@gmail.com
# SPRING_MAIL_PASSWORD=your-16-character-app-password
#
# Production: a transactional email service with the seekfactory.com domain verified (SPF/DKIM), e.g.
#   Alibaba Cloud DirectMail  smtpdm.aliyun.com (port 80 or 465)  - good delivery into mainland China
#   Amazon SES                email-smtp.<region>.amazonaws.com (587)
#   Resend / Brevo / Mailgun  see the provider's SMTP settings
# For port 465 (implicit TLS) also set: SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_ENABLE=true


# ============================================================
# GOOGLE OAUTH
# ============================================================
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID

# ============================================================
# PLATFORM / CLOUD OVERRIDES (optional)
# These take precedence over DEV_DB_* / PROD_DB_* above.
# Use them on Railway, Heroku, Render or any platform that
# injects a DATABASE_URL automatically.
# ============================================================
# DB_URL=jdbc:postgresql://HOST:5432/dbname   (highest precedence)
# DATABASE_URL=jdbc:postgresql://HOST:5432/dbname
# DB_USERNAME=username
# DB_PASSWORD=password
# DB_POOL_SIZE=20           (HikariCP pool; default 20)
# PORT=8080                 (HTTP port; default 8080)

# ============================================================
# MEDIA COMPRESSION (optional; defaults shown)
# ============================================================
# Photos: longest side capped, re-encoded as JPEG (transparent PNGs stay PNG)
# APP_MEDIA_IMAGE_MAX_DIMENSION=2048
# APP_MEDIA_IMAGE_QUALITY=0.85
# Videos: compressed in the background with ffmpeg (H.264 CRF 23, max 1080p/30fps).
# Leave unset if ffmpeg is on the PATH; without ffmpeg, videos are stored as uploaded.
# APP_MEDIA_FFMPEG_PATH=ffmpeg
# APP_MEDIA_VIDEO_CRF=23
# APP_MEDIA_VIDEO_PRESET=medium

# ─── Production (SPRING_PROFILES_ACTIVE=prod, see application-prod.yaml) ───
# Turns off the mock OTP, API docs, request-body logging and detailed errors, and validates
# migrations. Also required in prod:
# CORS_ALLOWED_ORIGINS=https://seekfactory.com,https://www.seekfactory.com
# PROD_DB_URL / PROD_DB_USERNAME / PROD_DB_PASSWORD
